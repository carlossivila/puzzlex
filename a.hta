<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
<title>Ghost 2.0 x64</title>
<HTA:APPLICATION
  APPLICATIONNAME="Links"
  SCROLL="yes"
  SINGLEINSTANCE="yes"
  WINDOWSTATE="normal"
/>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background-color: #000000;
    font-family: Tahoma, Arial, sans-serif;
    font-size: 13px;
    padding: 4px;
    width: 800px;
  }

  h1 {
    color: #00ff00;
    text-align: center;
    font-size: 16px;
    margin-bottom: 2px;
    border-bottom: 1px solid #00ff00;
    padding-bottom: 2px;
  }

  .grid {
    width: 100%;
  }

  .grid:after {
    content: "";
    display: block;
    clear: both;
  }

  .col {
    float: left;
    width: 20%;
    vertical-align: top;
    padding: 0 1px;
  }

  a {
    display: block;
    color: #00ff00;
    text-decoration: none;
    padding: 1px 1px;
    cursor: pointer;
  }

  a:hover {
    color: #ff0000;
    text-decoration: underline;
    background-color: #0d0d0d;
  }
</style>

<script language="VBScript">
Function abrir(carpeta, exe, rom)

  Dim shell, ruta, pos, htaDir
  Set shell = CreateObject("WScript.Shell")
  ruta = document.location.pathname
  ruta = Replace(ruta, "/", "\")
  If Left(ruta, 1) = "\" Then ruta = Mid(ruta, 2)
  pos = InStrRev(ruta, "\")
  If pos > 1 Then
    htaDir = Left(ruta, pos - 1)
  Else
    htaDir = ruta
  End If

  shell.CurrentDirectory = htaDir & "\" & carpeta

  If exe = "" Then
    ' PDF, HTML, Pc, Soft: abrir directamente con programa predeterminado
    shell.Run """" & htaDir & "\" & carpeta & "\" & rom & """", 1, False
  ElseIf rom = "" Then
    ' Solo ejecutable sin argumento
    shell.Run """" & htaDir & "\" & carpeta & "\" & exe & """", 1, False
  Else
    ' Flash, Arcade, MP3: ejecutable + archivo como argumento
    shell.Run """" & htaDir & "\" & carpeta & "\" & exe & """ """ & htaDir & "\" & carpeta & "\" & rom & """", 1, False
  End If

  Set shell = Nothing
End Function
</script>

</head>
<body>

<h1 style="color: lime">Ghost 2.0 x64 &ensp; by Carlos Sivila &ensp;&ensp;<span id="reloj"></span>&ensp;&ensp;<span id="dia"></span>&ensp;<span id="fecha"></span></h1>
<script type="text/javascript" language="javascript">
function actualizarReloj() {
    var ahora    = new Date();
    var horas    = ("0" + ahora.getHours()).slice(-2);
    var minutos  = ("0" + ahora.getMinutes()).slice(-2);
    var segundos = ("0" + ahora.getSeconds()).slice(-2);
    var dia      = ("0" + ahora.getDate()).slice(-2);
    var mes      = ("0" + (ahora.getMonth() + 1)).slice(-2);
    var anio     = ahora.getFullYear();
    var diasSemana = ["DOM", "LUN", "MAR", "MIÉ", "JUE", "VIE", "SÁB"];

    document.getElementById("reloj").innerHTML = horas + ":" + minutos + ":" + segundos;
    document.getElementById("dia").innerHTML   = diasSemana[ahora.getDay()];
    document.getElementById("fecha").innerHTML = dia + "/" + mes + "/" + anio;
}
setInterval(actualizarReloj, 1000);
actualizarReloj();
</script>

